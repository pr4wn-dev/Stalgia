#include "resource.h"
#include <winver.h>

IDI_APPICON ICON "app.ico"
IDR_APPLOGO RCDATA "stalgia-256.png"

1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,12,0,0
PRODUCTVERSION  1,12,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Stalgia"
            VALUE "FileDescription",  "Stalgia animated wallpaper"
            VALUE "FileVersion",      "1.12.0"
            VALUE "InternalName",     "Stalgia"
            VALUE "OriginalFilename", "Stalgia.exe"
            VALUE "ProductName",      "Stalgia"
            VALUE "ProductVersion",   "1.12.0"
            VALUE "LegalCopyright",   "GPL-3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
